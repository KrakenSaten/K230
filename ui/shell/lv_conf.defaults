# PocketOS shell LVGL configuration (generated into lv_conf.h at build time).
# Shared by the SDL simulator and the K230 DRM target; the display backend is
# selected by the CMake option POCKETOS_DISPLAY (sdl|drm).
LV_COLOR_DEPTH 16

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_USE_OS LV_OS_NONE

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_ASSERT_NULL 1
LV_USE_ASSERT_MALLOC 1

LV_USE_FS_STDIO 1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER 'A'

# Design System v0.1 fonts are converted IBM Plex bitmaps in ui/pocketui/fonts
# (pos_font_*), applied at runtime through the PocketUI styles; the body font
# is set on the screen by pocketui_style_screen(). Montserrat 20/32 stay
# enabled only as the LV_SYMBOL_* glyph source until the stroke icon set
# exists (DS §11, implementation step 5+). LV_FONT_DEFAULT is never used for
# visible text.
LV_FONT_MONTSERRAT_20 1
LV_FONT_MONTSERRAT_32 1
LV_FONT_DEFAULT &lv_font_montserrat_20

LV_USE_SYSMON 1
LV_USE_PERF_MONITOR 0

# Examples and demos are not built.
LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0

# Drivers: both compiled in, chosen at CMake time via POCKETOS_DISPLAY.
LV_USE_SDL 0
LV_USE_LINUX_DRM 0
LV_USE_EVDEV 0
