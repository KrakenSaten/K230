<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere, and no trust anchors: the app talks to one kind of
     peer, and trusts it by its pinned key alone (PinnedTrustManager). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
</network-security-config>
