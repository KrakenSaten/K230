{
  "about": "DOORS Relay v1 frame payload vectors (docs/api/relay.md section 5, Q12). Each entry is one frame payload, without its 4-byte length: 'json' is the payload as text, 'hex' is used where the payload is not valid UTF-8. Every 'reject' entry must be refused by a receiver and every 'accept' entry accepted. The key in them is the P-256 generator point, a valid public key; the signature MAYCAQECAQE= is well-formed DER (r = s = 1), which a receiver later fails to verify, not to decode.",
  "accept": [
    {"name": "ping zero", "json": "{\"type\":\"ping\",\"n\":0}"},
    {"name": "pong max n, members in another order", "json": "{\"n\":4294967295,\"type\":\"pong\"}"},
    {"name": "registered", "json": "{\"type\":\"registered\"}"},
    {"name": "connect without slot", "json": "{\"type\":\"connect\"}"},
    {"name": "pair_slot null clears", "json": "{\"type\":\"pair_slot\",\"slot\":null}"},
    {"name": "unit login, well-formed", "json": "{\"type\":\"unit\",\"spki\":\"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEaxfR8uEsQkf4vOblY6RA8ncDfYEt6zOg9KE5RdiYwpZP40Li/hp/m47n60p8D54WK84zV2sxXs7LtkBoN79R9Q==\",\"sig\":\"MAYCAQECAQE=\"}"},
    {"name": "whitespace between tokens", "json": " { \"type\" : \"ready\" } \n"}
  ],
