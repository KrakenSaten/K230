# Pinned inputs of the DOORS YOLOX training pipeline. Changing a pin is a
# proposal (AGENTS.md: no upgrades without one). Sourced by the shell
# scripts, read by run_record.py.

# YOLOX, Apache-2.0, Megvii-BaseDetection/YOLOX main as of 2025-06-08.
# Post-0.3.0: carries the lr_scheduler fix (#1670) and is long after the
# removal of the GPL-3.0 augmentation code (#765, PR #781, 2021-10-14).
YOLOX_REPO="https://github.com/Megvii-BaseDetection/YOLOX"
YOLOX_COMMIT="6ddff4824372906469a7fae2dc3206c7aa4bbaee"
YOLOX_DIR="${YOLOX_DIR:-$HOME/work/yolox-train/src/YOLOX}"

# Training environment (GPU). CPU smoke runs use the same versions, +cpu.
PYTHON_VERSION="3.10"
TORCH_VERSION="2.1.2"
TORCHVISION_VERSION="0.16.2"
CUDA_WHEEL="cu121"

# Training environment on an Intel GPU (XPU): native Windows, upstream
# PyTorch XPU wheels, no IPEX (setup_env_xpu.ps1). 2.13.0 is the newest
# build that computes correctly on an Arc B580 with driver 32.0.101.8531:
# 2.14.0 and 2.14.1 (SYCL runtime 2026.1) return wrong torch.nonzero and
# boolean-mask results there, and YOLOX's label assignment then crashes
# the device. xpu_check.py guards it. Smoke-verified 2026-10-06.
TORCH_XPU_VERSION="2.13.0"
TORCHVISION_XPU_VERSION="0.28.0"

# Conversion environment: nncase must match the runtime in the DOORS image.
NNCASE_VERSION="2.11.0"
DOTNET_CHANNEL="7.0"

# COCO 2017 annotations (CC BY 4.0). COCO publishes no checksum; the sha256
# of the two JSON files used goes into the dataset manifest.
COCO_ANN_URL="http://images.cocodataset.org/annotations/annotations_trainval2017.zip"

DOORS_SEED="20261004"
