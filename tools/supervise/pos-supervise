#!/bin/sh
# pos-supervise: keep a PocketOS service running with restart backoff and
# crash-loop detection. POSIX sh for BusyBox.
#
# Usage: pos-supervise <name> <command> [args...]
#   Restarts the command when it exits. Backoff doubles from 1 s to 30 s and
#   resets after the service has run for 60 s. If it restarts more than
#   POS_SUPERVISE_MAX_RESTARTS (5) times within 60 s, supervision stops and
#   $POCKETOS_RUNTIME_DIR/<name>.crashloop is written for the shell to show.
#   Stop with SIGTERM: the child is terminated and the supervisor leaves
#   only after the child has. Whoever stops the supervisor (the init
#   scripts) takes "supervisor gone" to mean "daemon gone", and a daemon
#   that is still leaving must not be mistaken for one that ignored the
#   signal. Escalation to SIGKILL stays with the init scripts.
#
# THE STATE FILE ($POCKETOS_RUNTIME_DIR/<name>.state)
#
# This supervisor is the only writer of what it knows about a service, and
# this file is how it says so. Before it existed, sysd inferred service health
# by parsing two files this script happens to leave behind (<name>.pid and the
# free-text <name>.crashloop line), which made a private implementation detail
# of a shell script into the source of a public API field. The state file is
# the contract instead: one explicit fact per line, written here, read by
# services/sysd/sysd_services.c, and by nothing else.
#
#   state_version=1        the format below; a reader that sees another
#                          number must not guess at the rest
#   name=<service>         the name this supervisor was started with
#   supervisor_pid=<pid>   this script
#   child_pid=<pid>        the supervised process, empty when none is running
#   running=0|1            whether a child was alive at the last update
#   crashloop=0|1          supervision has given up
#   last_exit_code=<n>     the child's last exit status, empty until it has
#                          exited once
#   restarts=<n>           restarts in the current 60 s window, 0 at start
#   backoff_s=<n>          the delay now being waited before the next start,
#                          empty when nothing is pending
#   started_uptime_s=<n>   /proc/uptime when the current child started, empty
#                          when none is running
#   updated_uptime_s=<n>   /proc/uptime when this file was written
#
# Values never contain spaces, quotes or newlines, so sh, awk and C read them
# the same way. Times are boot-relative (/proc/uptime) because the K230 has no
# RTC and the wall clock jumps from 1970 when NTP syncs.
#
# Writes go to a temp file in the same directory and are renamed over the real
# one, so a reader sees either the whole previous state or the whole new one
# and never a half-written file. The runtime directory is a tmpfs (VERIFIED,
# docs/hardware/V0.0.7_BLOCK2A_SMOKE.md), so all of this is boot-scoped: no
# state and no counter survives a reboot, and none of it pretends to.
#
# <name>.pid and <name>.crashloop are still written. The pid file exists only
# while that exact child is alive - it is removed the moment the child exits,
# so it is never a pid the kernel may have handed to something else. The init
# scripts need it to stop the daemon rather than only the supervisor, and the
# crash-loop marker is still named by the bring-up checklist; both are
# compatibility, and the state file is authoritative.
#
# The init scripts keep a third file, the supervisor's own pid, which they
# write from $! when they start this script. They name it in
# POS_SUPERVISE_PIDFILE, and this script removes it on every way out - the
# crash loop above all, which no init script is there to see. Left behind, it
# names a pid the kernel may hand to something else: the next start would
# take that process for this supervisor and refuse to start, and the next stop
# would signal it. It is removed only while it still holds this script's pid,
# so a file some later start has rewritten is never taken away.
#
# Environment: POCKETOS_RUNTIME_DIR (default /run/pocketos),
#              POCKETOS_LOG_DIR (default /var/lib/pocketos/log, persistent;
#              /var/log is a tmpfs on the K230 image),
#              POS_SUPERVISE_PIDFILE (optional; see above - not passed on to
#              the supervised command).
# These two defaults are the ones core/pocketpaths.h defines for the C side.
# This is POSIX sh and cannot link against it, so they are repeated here and
# tests/supervise_test.sh checks the two against each other.

NAME=$1
[ -n "$NAME" ] && [ $# -ge 2 ] || { echo "usage: pos-supervise <name> <command> [args...]" >&2; exit 2; }
shift
RUN_DIR=${POCKETOS_RUNTIME_DIR:-/run/pocketos}
LOG_DIR=${POCKETOS_LOG_DIR:-/var/lib/pocketos/log}
MAX=${POS_SUPERVISE_MAX_RESTARTS:-5}
WINDOW=60
mkdir -p "$RUN_DIR" "$LOG_DIR"
LOG="$LOG_DIR/supervise-$NAME.log"
CRASHLOOP="$RUN_DIR/$NAME.crashloop"
STATE="$RUN_DIR/$NAME.state"
SUP_PIDFILE=${POS_SUPERVISE_PIDFILE:-}
unset POS_SUPERVISE_PIDFILE
rm -f "$CRASHLOOP"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) supervise $NAME $*" | tee -a "$LOG" >&2; }
# Restart timing uses the boot clock, not the wall clock: on a board without
# an RTC the wall clock jumps from 1970 to the real date when NTP syncs, which
# once made a 214 s run look like 1788807617 s. /proc/uptime is monotonic.
now_s() { if [ -r /proc/uptime ]; then cut -d. -f1 /proc/uptime; else date +%s; fi; }

# The state file, written whole or not at all (see the header). The temp file
# is in the same directory so the rename cannot cross a filesystem, and it is
# removed if anything goes wrong rather than left for the next reader to find.
write_state() { # <running 0|1> <crashloop 0|1>
    _tmp="$STATE.tmp.$$"
    {
        echo "state_version=1"
        echo "name=$NAME"
        echo "supervisor_pid=$$"
        echo "child_pid=$CHILD"
        echo "running=$1"
        echo "crashloop=$2"
        echo "last_exit_code=$LAST_RC"
        echo "restarts=$restarts"
        echo "backoff_s=$BACKOFF_NOW"
        echo "started_uptime_s=$STARTED_AT"
        echo "updated_uptime_s=$(now_s)"
    } > "$_tmp" 2>/dev/null && mv -f "$_tmp" "$STATE" 2>/dev/null || rm -f "$_tmp"
}

# The init script's record of this supervisor goes with it (see the header).
drop_sup_pidfile() {
    [ -n "$SUP_PIDFILE" ] && [ "$(cat "$SUP_PIDFILE" 2>/dev/null)" = "$$" ] && rm -f "$SUP_PIDFILE"
    return 0
}

CHILD=""
SLEEPER=""
STOPPING=0
on_term() {
    STOPPING=1
    [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null
    # A backoff is waited for by a backgrounded sleep so that this signal can
    # end it. Killing it here is what wakes the wait below immediately.
    [ -n "$SLEEPER" ] && kill "$SLEEPER" 2>/dev/null
    return 0
}
trap on_term TERM INT

backoff=1
restarts=0
LAST_RC=""
STARTED_AT=""
BACKOFF_NOW=""
window_start=$(now_s)
write_state 0 0
while [ "$STOPPING" -eq 0 ]; do
    start=$(now_s)
    "$@" &
    CHILD=$!
    echo "$CHILD" > "$RUN_DIR/$NAME.pid"
    STARTED_AT=$start
    BACKOFF_NOW=""
    write_state 1 0
    wait "$CHILD"
    rc=$?
    if [ "$STOPPING" -eq 1 ]; then
        # The trap interrupted wait (POSIX: a trapped signal returns from
        # wait before the child is gone). The child has been told to leave
        # and is leaving; stay until it has. On unit A (M6, 2026-09-08) the
        # shell needs a moment to release the panel, the supervisor was
        # gone in 40 ms, and the init script SIGKILLed a shell that was
        # already on its way out and reported the stop as forced.
        while kill -0 "$CHILD" 2>/dev/null; do wait "$CHILD" 2>/dev/null; done
        CHILD=""
        break
    fi
    CHILD=""
    LAST_RC=$rc
    STARTED_AT=""
    # The pid file names a live child or does not exist. Leaving the dead
    # child's pid there through the backoff was a real hazard: the init
    # scripts read it to stop the daemon, and a pid reused in the meantime
    # would have been signalled, and then SIGKILLed, in its place.
    rm -f "$RUN_DIR/$NAME.pid"
    write_state 0 0
    now=$(now_s)
    ran=$((now - start))
    if [ "$ran" -ge "$WINDOW" ]; then
        backoff=1; restarts=0; window_start=$now
    fi
    if [ $((now - window_start)) -gt "$WINDOW" ]; then
        restarts=0; window_start=$now
    fi
    restarts=$((restarts + 1))
    log "exited rc=$rc after ${ran}s (restart $restarts, backoff ${backoff}s)"
    if [ "$restarts" -gt "$MAX" ]; then
        log "crash loop: $restarts restarts within ${WINDOW}s, giving up"
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) rc=$rc restarts=$restarts" > "$CRASHLOOP"
        rm -f "$RUN_DIR/$NAME.pid"
        write_state 0 1
        drop_sup_pidfile
        exit 1
    fi
    BACKOFF_NOW=$backoff
    write_state 0 0
    # The backoff is waited for with `wait`, not with a foreground sleep.
    # POSIX: wait returns immediately when a trapped signal arrives, while a
    # foreground `sleep 30` keeps the shell blocked until it finishes. The
    # init scripts give the supervisor 3 s and then escalate to SIGKILL, so
    # stopping a service that was backing off always reported "OK (forced)"
    # and skipped this script's own shutdown.
    sleep "$backoff" &
    SLEEPER=$!
    # The signal can arrive between the fork above and this assignment, where
    # the trap has no pid to kill yet.
    [ "$STOPPING" -eq 1 ] && kill "$SLEEPER" 2>/dev/null
    wait "$SLEEPER" 2>/dev/null
    if [ "$STOPPING" -eq 1 ]; then
        # However the wait ended, leave nothing behind: the sleep is reaped
        # here rather than orphaned onto init.
        kill "$SLEEPER" 2>/dev/null
        wait "$SLEEPER" 2>/dev/null
        SLEEPER=""
        break
    fi
    SLEEPER=""
    backoff=$((backoff * 2))
    [ "$backoff" -gt 30 ] && backoff=30
done
rm -f "$RUN_DIR/$NAME.pid"
STARTED_AT=""
BACKOFF_NOW=""
write_state 0 0
drop_sup_pidfile
log "stopped"
exit 0
