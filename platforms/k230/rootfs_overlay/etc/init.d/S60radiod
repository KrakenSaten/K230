#!/bin/sh
# PocketOS radiod under pos-supervise (BusyBox init). Backend comes from
# /etc/default/radiod and defaults to mock; see the note above RADIOD_BACKEND
# and platforms/k230/README.md.
#
# Logs: pocketlog files, crash reports and the supervisor log go to
# /var/lib/pocketos/log, which is on the persistent root filesystem (/var/log
# is a tmpfs on this image). The stdio capture there holds only what is not
# already in the pocketlog file (POCKETOS_LOG_STDERR=0); it is started fresh
# on every boot with the previous one kept as .1.

SUPERVISE=/usr/bin/pos-supervise
DAEMON=/usr/sbin/radiod
PIDFILE=/var/run/radiod-supervise.pid
# pos-supervise records the daemon it is watching here. stop needs it: asking
# the supervisor to go is not the same as the daemon going.
CHILD_PIDFILE=/run/pocketos/radiod.pid
LOGDIR=/var/lib/pocketos/log
LOGFILE=$LOGDIR/radiod.stdio.log
# The real backend is opt-in per unit, set in /etc/default/radiod. It is not
# waiting on anything technical: a transmit needs an operator who has confirmed
# which antenna is fitted to MMCX1, and the radio profile is not persisted, so
# every start returns to the values below. If the vendor launcher is switched
# back on it drives the same SPI device from its own UI; radiod holds
# /dev/spidev0.0 with flock and will refuse to start rather than share it.
#
# Radio on/off is not set here. It is the owner's choice, made in Controls
# (after the antenna prompt) or with `doors radio on|off`, and radiod keeps it
# in /var/lib/pocketos/radiod/radio.conf. With nothing stored the sx1262
# backend starts with the radio off and parked (asleep, GPIO44 low), so a
# fresh card, and a card upgraded from v0.0.12 or earlier, never transmits
# until somebody switches it on (docs/api/radio.md, "Radio on and off").
RADIOD_BACKEND=mock
RADIOD_REGION=EU868
# Requested TX power at every start. The radio profile is not persisted, so
# a restart always returns here (2 dBm, bench-safe) and never to the region
# maximum; raise it per session with `pos radio configure tx_power_dbm=N`
# or set it here in /etc/default/radiod once the antenna is confirmed.
RADIOD_TX_POWER_DBM=2
[ -r /etc/default/radiod ] && . /etc/default/radiod
export POCKETOS_LOG_DIR=$LOGDIR
export POCKETOS_LOG_STDERR=0

start() {
	printf "Starting radiod (%s, %s, %s dBm): " "$RADIOD_BACKEND" "$RADIOD_REGION" "$RADIOD_TX_POWER_DBM"
	[ -x "$DAEMON" ] || { echo "missing"; return 0; }
	mkdir -p /run/pocketos /var/run "$LOGDIR"
	# Both pids, not only the supervisor's. A supervisor that was killed
	# leaves its daemon running and adopted by init, and starting a second
	# supervisor on top of that gives the board two daemons.
	_sup=""; _child=""
	[ -s "$PIDFILE" ] && _sup=$(cat "$PIDFILE")
	[ -s "$CHILD_PIDFILE" ] && _child=$(cat "$CHILD_PIDFILE")
	if running "$_sup" || running "$_child"; then
		echo "already running"; return 0
	fi
	[ -f "$LOGFILE" ] && mv -f "$LOGFILE" "$LOGFILE.1"
	nohup "$SUPERVISE" radiod "$DAEMON" --backend "$RADIOD_BACKEND" --region "$RADIOD_REGION" --tx-power-dbm "$RADIOD_TX_POWER_DBM" >"$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
	echo "OK"
}

# Stop asked once and returned immediately, whether or not anything had gone.
# "restart" was stop, sleep 1, start, and on a host where the outgoing
# supervisor had not finished within that second the incoming one made a
# second daemon. stop now confirms before returning, and restart no longer
# needs the sleep.
STOP_TIMEOUT=3
if sleep 0.1 2>/dev/null; then STOP_STEP="0.1"; STOP_TICKS=$((STOP_TIMEOUT * 10)); else STOP_STEP="1"; STOP_TICKS=$STOP_TIMEOUT; fi

running() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
wait_gone() { # <pid>: true when it is gone within STOP_TIMEOUT
	_n=0
	while running "$1"; do
		_n=$((_n + 1))
		[ "$_n" -gt "$STOP_TICKS" ] && return 1
		sleep "$STOP_STEP"
	done
	return 0
}

stop() {
	printf "Stopping radiod: "
	sup=""; child=""
	[ -s "$PIDFILE" ] && sup=$(cat "$PIDFILE")
	[ -s "$CHILD_PIDFILE" ] && child=$(cat "$CHILD_PIDFILE")
	if ! running "$sup" && ! running "$child"; then
		rm -f "$PIDFILE" "$CHILD_PIDFILE"
		echo "not running"
		return 0
	fi
	forced=""
	kill "$sup" 2>/dev/null
	if ! wait_gone "$sup"; then
		# The supervisor is not responding to SIGTERM. Ask the daemon
		# directly: killing only the supervisor would leave the daemon
		# running, still holding the radio, and the next start would add a
		# second one.
		kill "$child" 2>/dev/null
		if ! wait_gone "$sup"; then
			kill -KILL "$child" 2>/dev/null
			kill -KILL "$sup" 2>/dev/null
			wait_gone "$sup"
			forced=" (forced)"
		fi
	fi
	if running "$child"; then
		# The supervisor is gone and its daemon is not - an orphan, whose
		# supervisor was killed or gave up. Asked to leave first: radiod
		# parks the transceiver on SIGTERM, and a SIGKILL would leave the
		# SX1262 powered and receiving. Forced only if it will not go.
		kill "$child" 2>/dev/null
		if ! wait_gone "$child"; then
			kill -KILL "$child" 2>/dev/null
			wait_gone "$child"
			forced=" (forced)"
		fi
	fi
	# The pid file is tracking, not decoration. Removing it before the
	# processes are gone throws away the only handle the next stop has, and
	# leaves the next start believing nothing is running - which is how a
	# failed stop used to end with two daemons instead of none.
	if running "$sup" || running "$child"; then
		echo "FAILED, still running"
		return 1
	fi
	rm -f "$PIDFILE" "$CHILD_PIDFILE"
	echo "OK$forced"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	# A stop that failed leaves the daemon running and its binaries in use.
	# Starting on top of it would add a second one, so restart stops here.
	restart|reload) stop && start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
# Whether the service actually stopped is the one thing a caller needs from
# this script; `exit 0` told every caller it had.
exit $?
