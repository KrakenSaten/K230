config BR2_PACKAGE_POCKETOS
	bool "Doors first-party userspace"
	select BR2_PACKAGE_CJSON
	select BR2_PACKAGE_LIBGPIOD2
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_PCM
	# The shell's display and input layer. These came in with the vendor
	# launcher's package until it left the image; libevdev had no other
	# selector at all.
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_JPEG
	# pos-vision's KPU runtime (linked statically) and its shared-memory
	# pool. libmmz came in with the vendor face_detect demo, which left the
	# image in 0.3.5. The header-only gsl-lite the nncase headers include has
	# no menu entry in the SDK (its Config.in is never sourced), so it is not
	# selected here: pocketos.mk's dependency list builds it.
	select BR2_PACKAGE_LIBNNCASE
	select BR2_PACKAGE_LIBMMZ
	help
	  Doors tools, services and shell for the LILYGO T-Display K230:
	  the doors CLI (with pos as its alias), pos-hwcheck, radiod, sysd,
	  netd, pocketos-shell. Source is synced from the Doors repository
	  by platforms/k230/scripts/apply_to_sdk.sh.

if BR2_PACKAGE_POCKETOS

config BR2_PACKAGE_POCKETOS_TOOLBOX
	bool "power-user CLI toolbox"
	default y
	select BR2_PACKAGE_HTOP
	select BR2_PACKAGE_NANO
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_CURL
	select BR2_PACKAGE_JQ
	select BR2_PACKAGE_ONIGURUMA
	select BR2_PACKAGE_STRACE
	select BR2_PACKAGE_IPERF3
	select BR2_PACKAGE_TCPDUMP
	help
	  A small fixed set of command-line tools for the Terminal app and
	  SSH, from Buildroot's own packages: htop, nano, curl, jq (with
	  Oniguruma for its regular expressions), strace, iperf3 and
	  tcpdump. No package manager. less and tree are BusyBox's.
	  Licences and upstreams: docs/LICENSING.md, "Power-user CLI
	  toolbox"; the per-image record is make legal-info.

endif
