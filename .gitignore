# meshcore-frame (tools/meshcore-frame). Not built by `make all` or `make
# test`, but an untracked binary left in the checkout is still a dirty tree to
# apply_to_sdk.sh, so its outputs are ignored like every other one here.
# The patterns are wider than the two default builds because the tool takes a
# SUFFIX: the sanitised build is meshcore-frame-asan in build-asan, and a
# cross-compile check names its own.
/tools/meshcore-frame/meshcore-frame*
/tools/meshcore-frame/build*/
/tests/meshcore_frame_test
/tests/meshcore_frame_test-*
# protocols/meshcore, the portable MeshCore protocol core. As with
# meshcore-frame above: not built by `make all` or `make test`, but an
# untracked binary left in the checkout is still a dirty tree to
# apply_to_sdk.sh, so its outputs are ignored like every other one here.
# The patterns cover the three builds the Makefile can produce - plain,
# sanitised (-asan) and the riscv64 cross-check.
/protocols/meshcore/libmeshcore*.a
/protocols/meshcore/build*/
/tests/meshcore_core_test
/tests/meshcore_core_test-*
/tests/meshcore_port_test
/tests/meshcore_port_test-*
/tests/meshcore_smoke_test
/tests/meshcore_smoke_test-*
# meshcored (services/meshcored). Like protocols/meshcore and
# tools/meshcore-frame above: not built by `make all` or `make test`, but an
# untracked binary left in the checkout is still a dirty tree to
# apply_to_sdk.sh, so its outputs are ignored like every other one here.
# The patterns cover the plain and sanitised test builds.
/services/meshcored/meshcored
/tests/meshcored_util_test
/tests/meshcored_util_test-*
/tests/meshcored_txmap_test
/tests/meshcored_txmap_test-*
/tests/meshcored_store_test
/tests/meshcored_store_test-*
/tests/meshcored_runtime_test
/tests/meshcored_runtime_test-*

# RIFT (apps/rift). The parts of the app without a display are built and run
# by `make test`; the app itself needs LVGL and is built by ui/shell (CMake),
# which builds out of tree. The fake meshcored is a test helper and is never
# installed.
/tests/rift_format_test
/tests/rift_model_test
/tests/rift_comms_test
/tests/rift_ipc_test
/tests/rift_notify_test
/tests/fake-meshcored
